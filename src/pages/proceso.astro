---
// src/pages/proceso.astro (VERSIÓN ACTUALIZADA A 4 PASOS)
import Layout from '../layouts/Layout.astro';

// ===== INICIO DE LA MODIFICACIÓN (NUEVO PROCESO DE 4 PASOS) =====
const pasosDeImplementacion = [
  {
    step: '01',
    title: 'Paso 1: Mapeo y Configuración del Flujo de Trabajo',
    description: 'No instalamos un software genérico. Primero, nos reunimos (virtualmente) con tu equipo para entender tu flujo de trabajo actual.',
    bullets: [
      '<strong>Análisis:</strong> ¿Cómo agendan citas hoy? ¿Cómo documentan? ¿Cómo dan seguimiento?',
      '<strong>Configuración:</strong> Personalizamos los 3 motores (Escriba, Gestión y Adherencia) para que se adapten a tu especialidad y tu forma de trabajar.',
      '<strong>Integración:</strong> Conectamos el sistema a tus herramientas existentes (Calendario, EMR si es compatible, etc.).'
    ],
    icon: 'configuracion'
  },
  {
    step: '02',
    title: 'Paso 2: Calibración del Motor 1 (El Escriba de IA)',
    description: 'Aquí ocurre la magia. Hacemos la primera consulta "sombra" contigo.',
    bullets: [
      '<strong>Prueba en Vivo:</strong> Usas el "Conector Humano" (Escriba de IA) mientras atiendes a un paciente (con su total consentimiento).',
      '<strong>Ajuste Fino:</strong> Revisamos juntos la primera nota SOAP generada por la IA. Calibramos la IA para que aprenda tu estilo personal.',
      '<strong>El "Clic" Mental:</strong> Este es el paso donde dejas de mirar el teclado y confías 100% en el sistema.'
    ],
    icon: 'calibracion'
  },
  {
    step: '03',
    title: 'Paso 3: Activación de los Motores 2 y 3',
    description: 'Una vez que el Motor 1 está calibrado, "encendemos" la automatización completa.',
    bullets: [
      '<strong>Motor 2 (Gestión):</strong> Activamos la agenda inteligente 24/7 y los recordatorios automáticos por WhatsApp/SMS. Tu equipo sentirá el alivio administrativo ese mismo día.',
      '<strong>Motor 3 (Adherencia):</strong> Cargamos tus protocolos de seguimiento. El sistema ahora sabe qué enviar a cada paciente con "Diagnóstico X".'
    ],
    icon: 'activacion'
  },
  {
    step: '04',
    title: 'Paso 4: El "Partner" (Soporte Continuo)',
    description: 'Este no es un proyecto que "entregamos y nos vamos".',
    bullets: [
      '<strong>Soporte SaaS:</strong> Como tu Partner Health-Tech, te damos soporte mensual continuo como parte de la suscripción.',
      '<strong>Optimización:</strong> Revisamos métricas clave contigo: ¿Cuántas horas has ahorrado? ¿Cómo va la tasa de adherencia del paciente?',
      '<strong>Evolución:</strong> El "Practice Co-Pilot" evoluciona. Cuando surjan nuevas tecnologías de IA, tu sistema se actualizará.'
    ],
    icon: 'soporte'
  }
];

// Nuevos iconos para los 4 pasos
const icons = {
  configuracion: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a.75.75 0 0 0 .75.75h13.5a.75.75 0 0 0 0-1.5H5.25a.75.75 0 0 0-.75.75Zm0 0A2.25 2.25 0 1 0 5.25 9.75a2.25 2.25 0 0 0-1.5 2.25Zm13.5 0a2.25 2.25 0 1 0-.75-2.25 2.25 2.25 0 0 0 .75 2.25Z" /></svg>`,
  calibracion: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h3.75" /></svg>`,
  activacion: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
  soporte: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.22-.1.447-.1.664 0 .414.158.79.41 1.06.252.27.603.428 1.002.428.398 0 .75-.158 1.002-.428.252-.27.41-.646.41-1.06 0-.217-.035-.444-.1-.664m-1.313 0h.01m-1.313 0c-.065.22-.1.447-.1.664 0 .414.158.79.41 1.06.252.27.603.428 1.002.428.398 0 .75-.158 1.002-.428.252-.27.41-.646.41-1.06 0-.217-.035-.444-.1-.664m5.168 4.34A9.75 9.75 0 1 0 4.5 12a9.75 9.75 0 0 0 13.718 8.164m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m0-1.06a.375.375 0 0 0 0 .53m0 0a.375.375 0 0 1 0 .53m0 0a.375.375 0 0 0 0 .53m0 0a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 0 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 0 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53" /></svg>`
};
// ===== FIN DE LA MODIFICACIÓN =====
---

<Layout 
  title="Nuestro Proceso de Implementación | Pixelarte Studio"
  description="De la Demo a la Automatización en 4 Pasos. Implementar el 'Practice Co-Pilot' es un onboarding tecnológico para médicos."
>
  
  <div class="bg-oscuro">
    <div class="container">
      
      <section class="page-header">
        <h1>Nuestro Proceso de Implementación</h1>
        <p>De la Demo a la Automatización en 4 Pasos. Implementar el "Practice Co-Pilot" no es un proyecto de marketing; es un onboarding tecnológico diseñado por médicos, para médicos. Te llevamos de la mano en un proceso claro y rápido para transformar tu consultorio.</p>
      </section>
      <section class="process-timeline">
        {pasosDeImplementacion.map((item) => (
          <div class="timeline-item">
            <div class="timeline-icon" set:html={icons[item.icon]} />
            <div class="timeline-content">
              <span class="timeline-step">{item.step}</span>
              <h3 class="timeline-title">{item.title}</h3>
              <p class="timeline-description">{item.description}</p>
              
              <ul class="timeline-bullets">
                {item.bullets.map(bullet => (
                  <li set:html={bullet} />
                ))}
              </ul>

            </div>
          </div>
        ))}
      </section>
      <section class="text-center py-16">
        <h2 class="text-4xl md:text-5xl font-playfair font-bold text-claro mb-10">
          ¿Listo para implementar el sistema?
        </h2>
        <a href="/aplicar" class="btn-primary">Aplicar para Sesión Estratégica</a>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* ===== INICIO DE LA MODIFICACIÓN (AÑADIR CLASES DE TAILWIND QUE FALTABAN) ===== */
  /* Estas clases las usamos en el H2 del CTA, pero no están en el CSS global */
  .text-4xl { font-size: 2.25rem; }
  .md\:text-5xl {
    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }
  .font-playfair { font-family: 'Playfair Display', serif; } /* Asumiendo que esta es la fuente */
  .font-bold { font-weight: 700; }
  .text-claro { color: var(--color-texto-claro); }
  .mb-10 { margin-bottom: 2.5rem; }
  /* ===== FIN DE LA MODIFICACIÓN ===== */

  .container {
    padding: 0 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .page-header {
    text-align: center;
    padding: 4rem 0;
    max-width: 800px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-texto-claro);
  }
  .page-header p {
    font-size: 1.25rem;
    color: var(--color-texto-secundario-claro);
    line-height: 1.6; /* Añadido para mejor legibilidad */
  }
  .process-timeline {
    max-width: 800px;
    margin: 0 auto 4rem;
    position: relative;
  }
  .timeline-item {
    display: flex;
    align-items: flex-start;
    position: relative;
    padding-bottom: 3rem;
  }
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 24px;
    top: 48px;
    width: 2px;
    height: calc(100% - 24px);
    background-color: var(--color-borde);
    transform: translateX(-50%);
  }
  .timeline-icon {
    background-color: var(--color-acento);
    color: white;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 10;
    border: 4px solid var(--color-fondo-oscuro);
  }
  .timeline-icon svg {
    width: 28px;
    height: 28px;
  }
  .timeline-content {
    margin-left: 1.5rem;
  }
  .timeline-step {
    background-color: var(--color-oscuro-contraste);
    color: var(--color-acento);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .timeline-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-texto-claro);
    margin: 0.75rem 0;
  }
  .timeline-description {
    color: var(--color-texto-secundario-claro);
    line-height: 1.6;
  }

  /* ===== INICIO DE LA MODIFICACIÓN (NUEVO CSS PARA BULLETS) ===== */
  .timeline-bullets {
    list-style-type: none;
    padding-left: 0;
    margin-top: 1rem;
    color: var(--color-texto-secundario-claro);
  }
  .timeline-bullets li {
    position: relative;
    padding-left: 1.75rem; /* Espacio para el check */
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }
  .timeline-bullets li::before {
    content: '✓'; /* Checkmark */
    position: absolute;
    left: 0;
    top: 0.1rem; /* Ajuste fino vertical */
    color: var(--color-acento);
    font-weight: 700;
  }
  .timeline-bullets li strong {
    color: var(--color-texto-claro); /* Resaltar los strong */
  }
  /* ===== FIN DE LA MODIFICACIÓN ===== */
</style>

