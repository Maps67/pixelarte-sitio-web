---
// src/pages/nuestro-sistema.astro (PÁGINA NUEVA)
import Layout from '../layouts/Layout.astro';

// ===== Contenido del "Stack Co-Pilot" =====
const stackCoPilot = [
  {
    step: '01',
    title: 'La Puerta de Entrada (Lo que Creamos)',
    description: 'Primero, diseñamos su interfaz de cara al paciente: su Página Web Profesional y su Tarjeta Digital de Acceso.',
    icon: 'puerta'
  },
  {
    step: '02',
    title: 'La Sala de Máquinas (Lo que Integramos)',
    description: 'Conectamos esa puerta de entrada a un "stack" de software que hemos seleccionado:',
    bullets: [
      '<strong>Motor 1 (Escriba):</strong> Integramos un Escriba de IA (como MediPin.ai) para que usted documente sus consultas sin teclear.',
      '<strong>Motores 2 y 3 (Gestión y Adherencia):</strong> Integramos un CRM de salud (como JIA.software) para automatizar su agenda 24/7 y el seguimiento post-consulta.'
    ],
    icon: 'motores'
  },
  {
    step: '03',
    title: 'El Servicio "Partner" (Lo que Garantizamos)',
    description: 'Nuestro verdadero valor es el servicio mensual. Nos encargamos de la calibración de la IA, la integración y el soporte, asegurando que todo funcione como un solo sistema.',
    icon: 'partner'
  }
];

// Iconos para el Stack
const icons = {
  puerta: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" /></svg>`,
  motores: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
  partner: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.22-.1.447-.1.664 0 .414.158.79.41 1.06.252.27.603.428 1.002.428.398 0 .75-.158 1.002-.428.252-.27.41-.646.41-1.06 0-.217-.035-.444-.1-.664m-1.313 0h.01m-1.313 0c-.065.22-.1.447-.1.664 0 .414.158.79.41 1.06.252.27.603.428 1.002.428.398 0 .75-.158 1.002-.428.252-.27.41-.646.41-1.06 0-.217-.035-.444-.1-.664m5.168 4.34A9.75 9.75 0 1 0 4.5 12a9.75 9.75 0 0 0 13.718 8.164m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m0-1.06a.375.375 0 0 0 0 .53m0 0a.375.375 0 0 1 0 .53m0 0a.375.375 0 0 0 0 .53m0 0a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 0 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53m-1.313-1.313a.375.375 0 0 0 0 .53m-1.313-1.313a.375.375 0 0 1 0 .53" /></svg>`
};
---

<Layout 
  title="El Stack Co-Pilot (Nuestro Sistema) | Pixelarte Studio"
  description="No solo vendemos software; integramos un 'stack' (MediPin + JIA) y damos el servicio 'Partner' para garantizar que funcione."
>
  
  <div class="bg-oscuro">
    <div class="container">
      
      <section class="page-header">
        <h1>El "Stack" Co-Pilot: Nuestro Modelo de Partner</h1>
        <p>El "Practice Co-Pilot" no es un solo software; es la unión de nuestro servicio experto de implementación con las mejores herramientas del mercado. Así es como funciona nuestro modelo de "Consultor Afiliado":</p>
      </section>

      <section class="process-timeline">
        {stackCoPilot.map((item) => (
          <div class="timeline-item">
            <div class="timeline-icon" set:html={icons[item.icon]} />
            <div class="timeline-content">
              <span class="timeline-step">{item.step}</span>
              <h3 class="timeline-title">{item.title}</h3>
              <p class="timeline-description">{item.description}</p>
              
              {item.bullets && (
                <ul class="timeline-bullets">
                  {item.bullets.map(bullet => (
                    <li set:html={bullet} />
                  ))}
                </ul>
              )}

            </div>
          </div>
        ))}
      </section>

       <section class="text-center py-16">
        <h2 class="text-4xl md:text-5xl font-playfair font-bold text-claro mb-10">
          ¿Listo para implementar el sistema?
        </h2>
        <a href="/aplicar" class="btn-primary">Aplicar para Sesión Estratégica</a>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* Clases de Tailwind que faltan */
  .text-4xl { font-size: 2.25rem; }
  .md\:text-5xl {
    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }
  .font-playfair { font-family: 'Playfair Display', serif; }
  .font-bold { font-weight: 700; }
  .text-claro { color: var(--color-texto-claro); }
  .mb-10 { margin-bottom: 2.5rem; }

  .container {
    padding: 0 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .page-header {
    text-align: center;
    padding: 4rem 0;
    max-width: 800px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-texto-claro);
  }
  .page-header p {
    font-size: 1.25rem;
    color: var(--color-texto-secundario-claro);
    line-height: 1.6;
  }
  .process-timeline {
    max-width: 800px;
    margin: 0 auto 4rem;
    position: relative;
  }
  .timeline-item {
    display: flex;
    align-items: flex-start;
    position: relative;
    padding-bottom: 3rem;
  }
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 24px;
    top: 48px;
    width: 2px;
    height: calc(100% - 24px);
    background-color: var(--color-borde);
    transform: translateX(-50%);
  }
  .timeline-icon {
    background-color: var(--color-acento);
    color: white;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 10;
    border: 4px solid var(--color-fondo-oscuro);
  }
  .timeline-icon svg {
    width: 28px;
    height: 28px;
  }
  .timeline-content {
    margin-left: 1.5rem;
  }
  .timeline-step {
    background-color: var(--color-oscuro-contraste);
    color: var(--color-acento);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .timeline-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-texto-claro);
    margin: 0.75rem 0;
  }
  .timeline-description {
    color: var(--color-texto-secundario-claro);
    line-height: 1.6;
  }
  .timeline-bullets {
    list-style-type: none;
    padding-left: 0;
    margin-top: 1rem;
    color: var(--color-texto-secundario-claro);
  }
  .timeline-bullets li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }
  .timeline-bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.1rem;
    color: var(--color-acento);
    font-weight: 700;
  }
  .timeline-bullets li strong {
    color: var(--color-texto-claro);
  }
</style>