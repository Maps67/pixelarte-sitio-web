---
// src/pages/testimonios.astro (VERSIÓN CON ENFOQUE PROFESIONAL)
import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

// Data: Único testimonio real (Dr. Díaz)
const testimonials = [
    {
        quote: "Pixelarte superó por completo nuestras expectativas. Su enfoque no fue solo de diseño, sino estratégico. Transformaron nuestro sitio web en una herramienta fundamental para la práctica médica, mejorando drásticamente el control y la comunicación con mis pacientes a través del innovador sistema de guías interactivas. Son verdaderos socios tecnológicos.",
        author: "Dr. Carlos A. Díaz",
        title: "Cirujano General",
        avatarUrl: "/images/dr-carlos-diaz.webp"
    }
];
---

<Layout title="Testimonios - Confían en Nosotros | PixelArte Studio">

    <section class="bg-oscuro py-16 md:py-24">
        <div class="container max-w-3xl mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-playfair font-bold text-claro mb-6">
                Confían en Nosotros
            </h1>
            <p class="text-lg text-secundario-claro max-w-2xl mx-auto">
                Nos enorgullece construir relaciones duraderas y resultados que hablan por sí mismos. No buscamos clientes, construimos alianzas estratégicas.
            </p>
        </div>
    </section>

    <section class="bg-claro py-16 md:py-24">
        <div class="container max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            
            <div class="text-center md:text-left">
                <h2 class="text-3xl md:text-4xl font-playfair font-bold text-oscuro mb-6">
                    Partner Destacado
                </h2>
                <p class="text-lg text-secundario">
                    La transición de una práctica tradicional a una operación Health-Tech requiere una confianza absoluta.
                </p>
                <p class="text-lg text-secundario mt-4">
                    El Dr. Díaz comparte su experiencia al implementar el sistema "Practice Co-Pilot" para automatizar su práctica y reducir la carga administrativa.
                </p>
            </div>
            
            <div class="testimonials-wrapper">
                {testimonials.map(testimonial => (
                    <TestimonialCard {...testimonial} />
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    /* Reutilizamos el 'wrapper' del código anterior.
      Este CSS asegura que la tarjeta se mantenga centrada
      y con el ancho correcto dentro de la columna de la cuadrícula.
    */
    .testimonials-wrapper {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        width: 100%;
    }

    :global(.testimonial-card) {
        flex: 0 1 100%;
        max-width: 600px;
    }

    @media (min-width: 768px) {
        :global(.testimonial-card) {
            /* Permite que la tarjeta ocupe todo el espacio de su columna */
            flex: 0 1 100%; 
        }
    }
</style>