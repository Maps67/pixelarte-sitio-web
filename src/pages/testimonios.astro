---
import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

// Data: Único testimonio real (Dr. Díaz)
const testimonials = [
    {
        quote: "Pixelarte superó por completo nuestras expectativas. Su enfoque no fue solo de diseño, sino estratégico. Transformaron nuestro sitio web en una herramienta fundamental para la práctica médica, mejorando drásticamente el control y la comunicación con mis pacientes a través del innovador sistema de guías interactivas. Son verdaderos socios tecnológicos.",
        author: "Dr. Carlos A. Díaz",
        title: "Cirujano General",
        // Asegúrate de que esta imagen exista en tu carpeta public/images/
        // Si no tienes la foto aún, usa: "https://placehold.co/150x150/E2E8F0/475569?text=CD"
        avatarUrl: "/images/dr-carlos-diaz.webp" 
    }
];
---

<Layout title="Testimonios - Confían en Nosotros | PixelArte Studio">
    <section class="testimonials-section-v3 standalone-page">
        <div class="container">
            <div class="section-header">
                <h1 class="section-title">Confían en Nosotros</h1>
                <p class="section-subtitle">
                    Nos enorgullece construir relaciones duraderas y resultados que hablan por sí mismos.
                </p>
            </div>
            
            <div class="testimonials-wrapper">
                {testimonials.map(testimonial => (
                    <TestimonialCard {...testimonial} />
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    .container { padding: 0 1rem; max-width: 1200px; margin: 0 auto; }
    
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-title { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-texto-oscuro, #1a202c); }
    .section-subtitle { font-size: 1rem; max-width: 600px; margin: 0 auto; color: var(--color-texto-secundario, #4a5568); }

    .testimonials-section-v3.standalone-page {
        background-color: var(--color-fondo-claro, #f7fafc); /* Fallback color si la variable falla */
        padding: 4rem 0;
        min-height: 80vh;
    }

    /* Wrapper Flexible:
       En lugar de Grid forzado, usamos Flexbox para centrar el único elemento.
       Cuando agregues más testimonios, esto se adaptará (wrap).
    */
    .testimonials-wrapper {
        display: flex;
        flex-wrap: wrap;
        justify-content: center; /* Centra la tarjeta horizontalmente */
        gap: 2rem;
        max-width: 1000px; 
        margin: 0 auto;
    }

    /* Ajuste del ancho de la tarjeta para que no se estire demasiado al estar sola */
    :global(.testimonial-card) {
        flex: 0 1 100%;
        max-width: 600px; /* Ancho máximo de lectura cómoda */
    }

    @media (min-width: 768px) {
        .container { padding: 0 2rem; }
        .testimonials-section-v3.standalone-page { padding: 6rem 0; } 
        .section-header { margin-bottom: 4rem; }
        .section-title { font-size: 2.5rem; }
        .section-subtitle { font-size: 1.125rem; }
        
        /* Si en el futuro son 2 tarjetas, ocuparán el 45-48% c/u */
        :global(.testimonial-card) {
            flex: 0 1 calc(50% - 1rem); 
        }
    }
</style>