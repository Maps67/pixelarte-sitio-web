---
// Archivo: src/pages/mediscribe/index.astro
import Layout from '../../layouts/Layout.astro';

const title = "MediScribe AI | Asistente Médico Inteligente - Pixelarte Studio";

// --- CONFIGURACIÓN DE WHATSAPP ---
// CAMBIA ESTO POR TU NÚMERO REAL (Ejemplo: 5213312345678)
const PHONE_NUMBER = "521XXXXXXXXXX"; 
const message = "Hola Pixelarte, vi su nueva tecnología MediScribe AI. Me interesa activar mi prueba piloto de 15 días.";
const whatsappLink = `https://wa.me/${5213347211199}?text=${encodeURIComponent(message)}`;
---

<Layout title={title}>
  <section class="relative bg-slate-900 text-white overflow-hidden py-20 lg:py-32">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-sm font-medium mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
        </span>
        Versión 3.2 (Beta)
      </div>
      
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Menos Teclado. <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-300">Más Paciente.</span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mb-10 leading-relaxed">
        El primer sistema de <strong>Inteligencia Ambiental</strong> diseñado para eliminar el trabajo administrativo. 
        MediScribe escucha, filtra el ruido y redacta tu nota clínica mientras tú miras a los ojos a tu paciente.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={whatsappLink} target="_blank" class="px-8 py-4 bg-teal-500 hover:bg-teal-400 text-slate-900 font-bold rounded-lg transition-all shadow-[0_0_20px_rgba(20,184,166,0.3)] flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            Iniciar Prueba de 15 Días
        </a>
        <a href="#funcionalidades" class="px-8 py-4 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-medium rounded-lg transition-all">
          Ver cómo funciona
        </a>
      </div>
    </div>
  </section>

  <section id="funcionalidades" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Ingeniería Clínica de Precisión</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">No es un simple dictado por voz. Es una arquitectura diseñada para el entorno médico ruidoso y complejo.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Algoritmo Anti-Eco</h3>
          <p class="text-slate-600">Implementamos lógica de deduplicación matemática. Si usas el celular y la web al mismo tiempo, el sistema sabe qué es eco y qué es voz real.</p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Formato NOM-004</h3>
          <p class="text-slate-600">La IA no solo transcribe; estructura. Separa automáticamente: Motivo de consulta, Exploración física, Diagnóstico y Plan.</p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-rose-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Privacidad Blindada</h3>
          <p class="text-slate-600">Arquitectura "Single Tenant" lógica. Tus datos de paciente están aislados con políticas de seguridad RLS desde el núcleo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">¿Listo para recuperar tu tiempo libre?</h2>
      <p class="text-lg text-slate-600 mb-8">
        Únete al programa piloto. Tienes 15 días de prueba total, sin tarjetas de crédito, sin compromiso.
      </p>
      <a href={whatsappLink} target="_blank" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white transition-all duration-200 bg-slate-900 rounded-lg hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        Crear mi cuenta en MediScribe
      </a>
    </div>
  </section>
</Layout>