                      {slide.title}
                    </h3>
                    <p class="text-slate-300 text-lg leading-relaxed font-light">
                      {slide.content}
                    </p>
                    {slide.image && (
                      <div class="rounded-xl overflow-hidden border border-slate-800 h-44 w-full relative mt-4 shadow-inner">
