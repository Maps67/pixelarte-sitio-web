      { icon: "📸", title: "Evidencia Fotográfica", text: "Incapacidad médica vinculada a fotos intraoperatorias para soporte de peritaje." }
    ]
  },
  {
    id: "nutrition",
    type: "grid",
    title: "Nutrición Clínica Multimodal",
    content: "Fusión de visión computacional y dietética basada en evidencia.",
