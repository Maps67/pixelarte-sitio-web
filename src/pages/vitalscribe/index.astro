<script is:inline>
  (function() {
    window.addEventListener('error', function(event) {
      if (event && (event.message === 'Script error.' || !event.filename)) {
        event.preventDefault();
        return true;
      }
    }, true);

    try {
      document.addEventListener('DOMContentLoaded', () => {
        // 1. CONTROL DE CAPTURA ASISTENCIAL
        const form = document.getElementById('lead-capture-form');
        const submitBtn = document.getElementById('submit-btn');

        if (form) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Estableciendo Enlace de Verificación...";
            }

            const fullName = document.getElementById('fullName')?.value.trim() || '';
            const cedula = document.getElementById('cedula')?.value.trim() || '';
            const phone = document.getElementById('phone')?.value.trim() || '';

            try {
              await new Promise(resolve => setTimeout(resolve, 1200)); 
              
              try {
                localStorage.setItem('vitalscribe_lead', JSON.stringify({ fullName, cedula, phone }));
              } catch (storageError) {
                console.warn("Storage access restricted in this sandbox environment:", storageError);
              }

              const baseMessage = `Estimado Enlace Institucional VitalScribe AI,\n\nHe realizado la inicialización de datos para la evaluación asistencial de la plataforma.\n\n*Profesional:* Dr(a). ${fullName}\n*Cédula de Especialidad:* ${cedula}\n*Contacto Registrado:* +52 ${phone}\n\nSolicito la validación de credenciales criptográficas de entorno seguro v15.3.`;
              window.open(`https://wa.me/5213347211199?text=${encodeURIComponent(baseMessage)}`, '_blank');

              setTimeout(() => {
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = "Activar Periodo de Evaluación Asistencial";
                }
                form.reset();
              }, 2000);

            } catch (innerError) {
              console.error("Error en el registro local de la credencial asistencial:", innerError);
              window.location.href = "https://vitalscribeai.com/";
            }
          });
        }

        // 2. CONTROL NATIVO DUAL DEL VISUALIZADOR ASISTENCIAL
        const presentationHub = document.getElementById('presentation-hub');
        const btnClinical = document.getElementById('mode-clinical-btn');
        const btnTechnical = document.getElementById('mode-technical-btn');

        if (presentationHub && btnClinical && btnTechnical) {
          btnClinical.addEventListener('click', () => {
            presentationHub.setAttribute('data-ux-mode', 'clinical');
            btnClinical.className = "px-6 py-2.5 rounded-full bg-teal-50 text-slate-950 font-bold text-sm transition-colors duration-300 flex items-center gap-2";
            btnTechnical.className = "px-6 py-2.5 rounded-full text-slate-400 hover:text-white font-medium text-sm transition-colors duration-300 flex items-center gap-2";
            document.querySelectorAll('.technical-text').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.clinical-text').forEach(el => el.classList.remove('hidden'));
          });

          btnTechnical.addEventListener('click', () => {
            presentationHub.setAttribute('data-ux-mode', 'technical');
            btnTechnical.className = "px-6 py-2.5 rounded-full bg-teal-50 text-slate-950 font-bold text-sm transition-colors duration-300 flex items-center gap-2";
            btnClinical.className = "px-6 py-2.5 rounded-full text-slate-400 hover:text-white font-medium text-sm transition-colors duration-300 flex items-center gap-2";
            document.querySelectorAll('.clinical-text').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.technical-text').forEach(el => el.classList.remove('hidden'));
          });
        }

        // 3. CORE ENGINE DEL VISUALIZADOR ATRIBUTO-CONDUCIDO
        const tabs = document.querySelectorAll('.slide-tab');
        const panes = document.querySelectorAll('.slide-pane');
        const prevBtn = document.getElementById('prev-slide-btn');
        const nextBtn = document.getElementById('next-slide-btn');
        const counterBadge = document.getElementById('slide-counter-badge');
        
        let activeIndex = 0;
        const totalSlides = tabs.length;

        function updateViewer(index) {
          if (index < 0 || index >= totalSlides) return;
          activeIndex = index;

          tabs.forEach((tab, idx) => {
            if (idx === index) {
              tab.setAttribute('data-state', 'active');
              tab.classList.add('bg-teal-950/40', 'text-teal-300', 'border-teal-500/30');
              tab.classList.remove('text-slate-400', 'border-transparent');
            } else {
              tab.setAttribute('data-state', 'inactive');
              tab.classList.remove('bg-teal-950/40', 'text-teal-300', 'border-teal-500/30');
              tab.classList.add('text-slate-400', 'border-transparent');
            }
          });

          panes.forEach((pane, idx) => {
            if (idx === index) {
              pane.setAttribute('data-state', 'active');
              pane.classList.remove('hidden', 'opacity-0', 'absolute', 'pointer-events-none', 'h-0');
              pane.classList.add('flex', 'opacity-100', 'relative');
            } else {
              pane.setAttribute('data-state', 'inactive');
              pane.classList.remove('flex', 'opacity-100', 'relative');
              pane.classList.add('hidden', 'opacity-0', 'absolute', 'pointer-events-none', 'h-0');
            }
          });

          if (counterBadge) counterBadge.textContent = `SLIDE ${index + 1} DE ${totalSlides}`;
          if (prevBtn) {
            prevBtn.style.opacity = index === 0 ? '0.5' : '1';
            prevBtn.style.pointerEvents = index === 0 ? 'none' : 'auto';
          }
          if (nextBtn) nextBtn.textContent = index === totalSlides - 1 ? 'REINICIAR INTERFAZ ↺' : 'SIGUIENTE SECCIÓN →';
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => updateViewer(index));
        });

        if (prevBtn) prevBtn.addEventListener('click', () => { if (activeIndex > 0) updateViewer(activeIndex - 1); });
        if (nextBtn) nextBtn.addEventListener('click', () => { updateViewer(activeIndex < totalSlides - 1 ? activeIndex + 1 : 0); });

        // 4. ESTRUCTURACIÓN DEL MODAL REGLAMENTARIO
        const modal = document.getElementById('legal-modal');
        const triggerPrivacy = document.getElementById('trigger-privacy-btn');
        const triggerTerms = document.getElementById('trigger-terms-btn');
        const closeModal = document.getElementById('close-legal-modal');
        const tabPrivacyBtn = document.getElementById('tab-privacy-btn');
        const tabTermsBtn = document.getElementById('tab-terms-btn');
        const tabPrivacyContent = document.getElementById('tab-privacy-content');
        const tabTermsContent = document.getElementById('tab-terms-content');

        if (triggerPrivacy) {
          triggerPrivacy.addEventListener('click', () => {
            modal?.classList.remove('hidden');
            tabPrivacyBtn?.click();
          });
        }
        if (triggerTerms) {
          triggerTerms.addEventListener('click', () => {
            modal?.classList.remove('hidden');
            tabTermsBtn?.click();
          });
        }
        if (closeModal) closeModal.addEventListener('click', () => modal?.classList.add('hidden'));

        if (tabPrivacyBtn && tabTermsBtn && tabPrivacyContent && tabTermsContent) {
          tabPrivacyBtn.addEventListener('click', () => {
            tabPrivacyBtn.className = "px-4 py-2 text-sm font-bold rounded-lg transition-all bg-slate-900 text-white shadow";
            tabTermsBtn.className = "px-4 py-2 text-sm font-semibold rounded-lg transition-all text-slate-600 hover:bg-slate-200 hover:text-slate-900";
            tabPrivacyContent.classList.remove('hidden');
            tabTermsContent.classList.add('hidden');
          });

          tabTermsBtn.addEventListener('click', () => {
            tabTermsBtn.className = "px-4 py-2 text-sm font-bold rounded-lg transition-all bg-slate-900 text-white shadow";
            tabPrivacyBtn.className = "px-4 py-2 text-sm font-semibold rounded-lg transition-all text-slate-600 hover:bg-slate-200 hover:text-slate-900";
            tabTermsContent.classList.remove('hidden');
            tabPrivacyContent.classList.add('hidden');
          });
        }

        // INICIALIZACIÓN DE LA COHORTE SOT
        updateViewer(0);
        btnClinical?.click();
      });
    } catch (e) {
      console.error("Safe capsule framework caught context state exception:", e);
    }
  })();
</script>