                      {slide.title}
                    </h3>
                    {Array.isArray(slide.content) && (
                      <ul class="space-y-4">
                        {slide.content.map((bullet) => {
                          const [header, ...rest] = bullet.split(':');
                          return (
                            <li class="flex items-start gap-3 bg-slate-900/60 p-3 rounded-lg border border-slate-800/60">
                              <span class="text-teal-400 mt-1">
