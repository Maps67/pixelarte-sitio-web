                                </svg>
                              </span>
                              <p class="text-slate-300 text-sm">
                                <strong class="text-white">{header}:</strong>{rest.join(':')}
                              </p>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {slide.image && (
                      <div class="rounded-xl overflow-hidden border border-slate-800 h-32 w-full mt-4">
                        <img src={slide.image} alt={slide.title} class="w-full h-full object-cover opacity-50" />
                      </div>
                    )}
                  </div>
                )}

                {slide.type === 'grid' && (
                  <div class="space-y-6">
                    <h3 class="text-2xl md:text-3xl font-extrabold text-white flex items-center gap-2">
                      <span class="w-1.5 h-6 bg-teal-500 rounded-full"></span>
