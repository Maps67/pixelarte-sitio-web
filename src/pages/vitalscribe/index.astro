  {
    id: "admin_gatekeeper",
    type: "grid",
    title: "Pasarela Edge Functions y Control de Integridad",
    content: "Orquestación de microservicios públicos regulados en Supabase e inyección de secretos.",
    items: [
      { icon: "🗄️", title: "Bypass JWT Control", text: "Despliegue estructural con la directiva 'verify_jwt = false' en la nube para permitir consultas pre-registro seguras." },
      { icon: "🔑", title: "Inyección Vault Terminal", text: "Almacenamiento inexpugnable de secretos de producción (TURNSTILE_SECRET_KEY) directo en el clúster de Supabase." },
      { icon: "🔒", title: "CORS Anti-DeDoS Patched", text: "Filtro de orígenes cruzados que tolera handshakes emulados en localhost y restricciones rígidas." },
      { icon: "👁️", title: "Preservación NOM-004", text: "Estatus remotos dinámicos ('read_only', 'active') sincronizados para auditorías sin pérdida de datos." }
    ]
  },
  {
    id: "roadmap",
    type: "grid",
    title: "V12.0: El Futuro de la Precisión",
    content: "Hacia la hiper-personalización y el modelado bibliográfico avanzado.",
    items: [
      { icon: "🕸️", title: "Mapeo Farmacológico", text: "Mapeo de interacciones complejas en polifarmacia referenciando bases de datos de farmacovigilancia internacional." },
      { icon: "👥", title: "Espejos Fisiológicos", text: "Espejos Fisiológicos de referencia para ilustrar escenarios de riesgo clínico basados en Guías de Práctica Clínica." },
      { icon: "🧠", title: "Investigación Delegada", text: "Agentes de Investigación Delegada (RAG) para rastreo, lectura y síntesis de literatura médica bajo demanda." },
      { icon: "🔬", title: "Alertas Genómicas", text: "Integración de alertas fármaco-genómicas que exponen consideraciones de dosificación para cada fenotipo." }
    ]
  },
  {
    id: "closing",
    type: "hero",
