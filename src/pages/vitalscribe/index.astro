---
// Archivo: src/pages/vitalscribe/index.astro
import Layout from '../../layouts/Layout.astro';

// ==========================================
// CONFIGURACIÓN Y METADATOS
// ==========================================
const title = "VitalScribe | Gestión Clínica con IA y Seguridad Bancaria";
const description = "La primera plataforma de gestión clínica en México impulsada por Google Gemini. Notas SOAP, alertas de riesgo y seguridad NOM-004.";
const APP_URL = "https://vitalscribeai.com/";

// ==========================================
// IMÁGENES DE STOCK (Optimized URLs)
// ==========================================
// Hero: Médico moderno con tecnología
const HERO_IMG = "https://images.unsplash.com/photo-1576091160550-217358c7db81?auto=format&fit=crop&q=80&w=2070";
// Feature A: IA / Cerebro Digital
const AI_FEATURE_IMG = "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&q=80&w=1000";
// Feature B: Dashboard / Gestión
const DASHBOARD_IMG = "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=1000";
// Security: Concepto de Bóveda/Seguridad
const SECURITY_IMG = "https://images.unsplash.com/photo-1614064641938-3e8529437217?auto=format&fit=crop&q=80&w=1000";
---

<Layout title={title}>

  <section class="relative overflow-hidden bg-slate-900 min-h-screen flex items-center pt-20 pb-20">
    
    <div class="absolute inset-0 z-0">
      <img 
        src={HERO_IMG} 
        alt="Consultorio médico moderno" 
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/40"></div>
    </div>

    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-teal-500 rounded-full mix-blend-overlay filter blur-[120px] opacity-20 animate-pulse-slow"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-20"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/50 border border-teal-500/30 text-teal-300 text-xs font-bold uppercase tracking-widest mb-8 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
        v5.5 Stable • Powered by Google Gemini
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Dedícate a curar. <br class="hidden md:block" />
        Deja que la IA se encargue de <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-300">escribir.</span>
      </h1>

      <p class="text-xl md:text-2xl text-slate-300 max-w-4xl mx-auto mb-10 leading-relaxed font-light">
        La primera plataforma de gestión clínica en México impulsada por <strong>Google Gemini</strong>. Genera notas SOAP en segundos, detecta riesgos automáticamente y blinda tus expedientes con seguridad bancaria (NOM-004).
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a 
          href={APP_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-8 py-4 bg-teal-500 hover:bg-teal-400 text-slate-900 font-bold text-lg rounded-xl transition-all shadow-[0_0_20px_rgba(20,184,166,0.4)] flex items-center justify-center gap-2 hover:-translate-y-1"
        >
          Empieza Gratis Hoy
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
        </a>
        
        <a 
          href="#demo" 
          class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium text-lg rounded-xl transition-all backdrop-blur-sm flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Ver Demo en Video
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white relative z-20 -mt-10 rounded-t-[3rem]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid md:grid-cols-3 gap-12">
        
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-xl transition-all group">
          <div class="w-14 h-14 bg-teal-100 text-teal-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Velocidad Sobrenatural</h3>
          <p class="text-slate-600 leading-relaxed">
            No más horas extra llenando expedientes. Nuestra IA redacta, estructura y resume por ti en segundos.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-xl transition-all group">
          <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Seguridad "Zero Trust"</h3>
          <p class="text-slate-600 leading-relaxed">
            Tus datos están encriptados de extremo a extremo. Ni nosotros podemos ver lo que escribes.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-xl transition-all group">
          <div class="w-14 h-14 bg-pink-100 text-pink-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Diseño para Humanos</h3>
          <p class="text-slate-600 leading-relaxed">
            Una interfaz tan limpia e intuitiva que no necesitas manual de usuario. Si sabes usar un correo, sabes usar VitalScribe.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2">
          <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider text-teal-600 uppercase bg-teal-100 rounded-full">
            Powered by Gemini
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Asistente Clínico Inteligente</h2>
          <p class="text-lg text-slate-600 mb-8">
            No es un simple autocompletado. Es un residente virtual que nunca se cansa.
          </p>
          <ul class="space-y-6">
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-500 flex items-center justify-center text-white mt-1">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Transcripción Estructurada</h4>
                <p class="text-slate-500">Convierte notas rápidas en formatos clínicos estándar (SOAP, Historia Clínica).</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-red-500 flex items-center justify-center text-white mt-1">!</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Detección de Riesgos Activa</h4>
                <p class="text-slate-500">El sistema "lee" tus notas en tiempo real. Si detecta parámetros fuera de rango (ej. Hipertensión Crítica), genera una alerta visual inmediata.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-500 flex items-center justify-center text-white mt-1">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Resúmenes de Evolución</h4>
                <p class="text-slate-500">¿Paciente complejo? La IA analiza las últimas 5 consultas y te da un resumen ejecutivo en 3 segundos.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="lg:w-1/2 relative">
          <div class="absolute inset-0 bg-teal-500 blur-3xl opacity-20 rounded-full"></div>
          <img src={AI_FEATURE_IMG} alt="IA Analizando datos médicos" class="relative rounded-2xl shadow-2xl border-4 border-white transform hover:scale-[1.02] transition-transform duration-500" />
        </div>
      </div>

      <div class="flex flex-col lg:flex-row-reverse gap-16 items-center">
        <div class="lg:w-1/2">
          <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider text-indigo-600 uppercase bg-indigo-100 rounded-full">
            Sin Fricción
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Gestión de Pacientes</h2>
          <p class="text-lg text-slate-600 mb-8">
            Centraliza toda la información en una sola vista panorámica diseñada para la velocidad.
          </p>
          <ul class="space-y-6">
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center text-white mt-1">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Expediente Clínico Digital</h4>
                <p class="text-slate-500">Antecedentes, alergias, notas y archivos adjuntos en un solo lugar.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center text-white mt-1">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Etiquetado Inteligente</h4>
                <p class="text-slate-500">Organiza pacientes por estado, diagnóstico o nivel de riesgo con Tags visuales.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center text-white mt-1">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Búsqueda Instantánea</h4>
                <p class="text-slate-500">Encuentra a cualquier paciente en milisegundos por nombre, fecha o padecimiento.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="lg:w-1/2 relative">
          <div class="absolute inset-0 bg-indigo-500 blur-3xl opacity-20 rounded-full"></div>
          <img src={DASHBOARD_IMG} alt="Dashboard de VitalScribe" class="relative rounded-2xl shadow-2xl border-4 border-white transform hover:scale-[1.02] transition-transform duration-500" />
        </div>
      </div>

      <div class="bg-slate-900 rounded-3xl p-8 md:p-12 text-center relative overflow-hidden">
        <div class="relative z-10">
          <h3 class="text-2xl font-bold text-white mb-4">Soporte Técnico Automatizado 24/7</h3>
          <p class="text-slate-300 max-w-2xl mx-auto mb-6">
            <strong class="text-teal-400">VitalScribe Bot:</strong> ¿No sabes cómo editar una nota o cambiar tu contraseña? Nuestro Asistente Técnico integrado te guía paso a paso dentro de la app, sin esperar correos de soporte.
          </p>
        </div>
        <div class="absolute top-0 right-0 w-64 h-64 bg-teal-500 rounded-full mix-blend-overlay filter blur-[60px] opacity-20"></div>
      </div>

    </div>
  </section>

  <section class="py-24 bg-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          Seguridad Grado Bancario
        </div>
        <h2 class="text-4xl font-bold text-white mb-6">Tus datos, en una Bóveda Digital.</h2>
        <p class="text-xl text-slate-400 max-w-3xl mx-auto">
          Entendemos que la privacidad de tus pacientes es sagrada. Por eso, VitalScribe no solo "cumple", sino que excede los estándares de la industria.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div class="bg-slate-800 p-8 rounded-2xl border border-slate-700">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-xl font-bold text-white mb-2">Arquitectura Blindada (v2.0)</h3>
          <p class="text-slate-400 text-sm">
            Construido sobre Supabase con tecnología RLS (Row Level Security). Cada dato tiene una llave digital única que solo tú posees.
          </p>
        </div>
        <div class="bg-slate-800 p-8 rounded-2xl border border-slate-700">
          <div class="text-4xl mb-4">⚖️</div>
          <h3 class="text-xl font-bold text-white mb-2">Cumplimiento Normativo</h3>
          <p class="text-slate-400 text-sm">
            Estructura de base de datos diseñada para cumplir rigurosamente con la <strong>NOM-004-SSA3-2012</strong> del Expediente Clínico Electrónico en México.
          </p>
        </div>
        <div class="bg-slate-800 p-8 rounded-2xl border border-slate-700">
          <div class="text-4xl mb-4">🔒</div>
          <h3 class="text-xl font-bold text-white mb-2">Encriptación Total</h3>
          <p class="text-slate-400 text-sm">
            Datos cifrados con AES-256 en reposo (servidor) y TLS 1.3 en tránsito (mientras viajan por internet).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900">Tu consulta, simplificada.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <div class="relative flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center text-2xl font-bold text-teal-600 mb-6 z-10 relative">1</div>
          <div class="absolute top-8 left-1/2 w-full h-1 bg-slate-100 -z-0 hidden md:block"></div> <h3 class="text-xl font-bold text-slate-900 mb-2">Registro Rápido</h3>
          <p class="text-slate-600">Crea tu cuenta y configura tu perfil médico en 2 minutos.</p>
        </div>

        <div class="relative flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center text-2xl font-bold text-indigo-600 mb-6 z-10 relative">2</div>
          <div class="absolute top-8 left-1/2 w-full h-1 bg-slate-100 -z-0 hidden md:block"></div> <h3 class="text-xl font-bold text-slate-900 mb-2">Consulta Asistida</h3>
          <p class="text-slate-600">Atiende a tu paciente. Escribe o dicta ideas clave. La IA estructura la nota formal por ti.</p>
        </div>

        <div class="relative flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center text-2xl font-bold text-pink-600 mb-6 z-10 relative">3</div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Gestión y Seguimiento</h3>
          <p class="text-slate-600">Revisa el dashboard, monitorea alertas de riesgo y accede desde cualquier dispositivo.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50 border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900">Preguntas Frecuentes</h2>
        <p class="text-slate-500 mt-2">Rompiendo objeciones comunes</p>
      </div>

      <div class="space-y-4">
        
        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Necesito instalar algo en mi computadora?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            No. VitalScribe es <strong>100% en la nube (SaaS)</strong>. Accedes desde tu navegador seguro (Chrome, Safari, Edge) sin instalaciones complejas.
          </p>
        </details>

        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Qué pasa si se va mi internet?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            La tecnología React permite una carga ultra-rápida y el sistema guarda <strong>borradores automáticos</strong> localmente para minimizar pérdidas de información hasta que recuperes la conexión.
          </p>
        </details>

        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿La IA sustituye mi criterio médico?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            Nunca. La IA es tu <strong>copiloto administrativo</strong>; tú eres el capitán clínico. Tú validas, corriges y firmas cada nota antes de que se guarde en el expediente.
          </p>
        </details>

      </div>
    </div>
  </section>

  <footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row justify-between items-center mb-8">
        <div class="mb-4 md:mb-0">
          <h2 class="text-2xl font-bold text-white tracking-tighter">VitalScribe<span class="text-teal-400">.</span></h2>
          <p class="text-slate-500 text-sm mt-1">Donde la intuición médica se encuentra con la precisión artificial.</p>
        </div>
        <div class="flex gap-6 text-slate-400 text-sm font-medium">
          <a href="#" class="hover:text-white transition-colors">Aviso de Privacidad</a>
          <a href="#" class="hover:text-white transition-colors">Términos de Servicio</a>
          <a href="#" class="hover:text-white transition-colors">Soporte</a>
        </div>
      </div>

      <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-slate-500 text-xs">
          © 2025 VitalScribe. Todos los derechos reservados.
        </p>
        <div class="flex items-center gap-4">
          <span class="px-2 py-1 bg-slate-800 rounded border border-slate-700 text-[10px] text-slate-400 font-mono">
            Secured by Supabase
          </span>
          <span class="px-2 py-1 bg-slate-800 rounded border border-slate-700 text-[10px] text-slate-400 font-mono">
            Powered by Google Gemini
          </span>
        </div>
      </div>

    </div>
  </footer>

</Layout>

<style>
    @keyframes pulse-slow {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.15; transform: scale(1.1); }
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s infinite ease-in-out;
    }
</style>