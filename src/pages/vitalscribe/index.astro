---
// Archivo: src/pages/vitalscribe/index.astro
import Layout from '../../layouts/Layout.astro';

// Metadatos actualizados para v5.5
const title = "VitalScribe v5.5 | Plataforma Integral de Gestión Clínica con IA";
const description = "Gestión clínica blindada con IA Gemini y seguridad Zero-Trust. Reduzca el 80% de carga administrativa y cumpla con NOM-004.";
const APP_URL = "https://vitalscribeai.com/";

// Imágenes de stock curadas (Unsplash) - Optimizadas para carga rápida
const HERO_IMG = "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&q=80&w=2070";
const AI_IMG = "https://images.unsplash.com/photo-1551076882-68b47d190267?auto=format&fit=crop&q=80&w=2000";
const SECURITY_IMG = "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&q=80&w=1000";
const CHAT_IMG = "https://images.unsplash.com/photo-1581056771107-24ca5f033842?auto=format&fit=crop&q=80&w=1000";
---

<Layout title={title}>
  
  <section class="relative overflow-hidden bg-slate-900 pt-24 pb-32 lg:pt-40 lg:pb-48">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-teal-500 rounded-full mix-blend-overlay filter blur-[120px] opacity-20 -translate-y-1/2 translate-x-1/4 animate-pulse-slow"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-20 translate-y-1/3 -translate-x-1/4"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800 border border-teal-500/30 text-teal-300 text-xs font-bold uppercase tracking-widest mb-8 shadow-lg shadow-teal-900/20 backdrop-blur-md">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-teal-500"></span>
        </span>
        VitalScribe v5.5 • Powered by Gemini
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight text-white mb-8 leading-tight">
        Donde la intuición médica se encuentra con la <br class="hidden md:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-400">Precisión Artificial</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-slate-300 max-w-4xl mx-auto mb-12 leading-relaxed font-light">
        Más que un expediente digital, es su <strong class="text-white font-semibold">Asistente Clínico Inteligente</strong>. Elimine el 80% de la carga administrativa y recupere el tiempo para lo que realmente importa: sus pacientes.
      </p>

      <div class="flex flex-col sm:flex-row gap-5 justify-center items-center">
        <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-10 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-lg rounded-xl transition-all shadow-[0_0_30px_rgba(20,184,166,0.4)] flex items-center justify-center gap-3 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(20,184,166,0.6)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
            Iniciar Demo v5.5
        </a>
        <a href="#funcionalidades" class="w-full sm:w-auto px-10 py-4 bg-slate-800/50 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-white font-medium text-lg rounded-xl transition-all backdrop-blur-sm flex items-center justify-center">
          Ver Arquitectura
        </a>
      </div>
    </div>

    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
        <img src={HERO_IMG} alt="Fondo médico tecnológico" class="w-full h-full object-cover grayscale" />
    </div>
  </section>

  <section id="funcionalidades" class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        
        <div class="order-2 lg:order-1 relative group">
           <div class="absolute -inset-4 bg-gradient-to-r from-teal-500 to-cyan-500 rounded-2xl opacity-20 blur-xl group-hover:opacity-30 transition duration-500"></div>
           <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-100">
               <img src={AI_IMG} alt="Doctor usando tablet con IA" class="w-full h-auto object-cover transform transition duration-700 group-hover:scale-105" />
               <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur p-4 rounded-xl border border-slate-200 shadow-lg">
                   <div class="flex items-center gap-3 mb-2">
                       <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                       <span class="text-xs font-bold text-slate-500 uppercase">Alerta Gemini Detectada</span>
                   </div>
                   <p class="text-sm text-slate-800 font-medium">
                     "Paciente con antecedentes de arritmia reporta disnea. <span class="text-red-600 font-bold bg-red-50 px-1 rounded">Riesgo Alto: Revisar ECG reciente.</span>"
                   </p>
               </div>
           </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-teal-50 text-teal-700 text-sm font-bold mb-6">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            Motor Gemini Integration
          </div>
          <h2 class="text-4xl font-bold text-slate-900 mb-6">No es una base de datos.<br>Es un cerebro activo.</h2>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            VitalScribe escucha, entiende y estructura. El sistema no solo guarda información, sino que participa activamente en la consulta para evitar errores y omisiones.
          </p>
          
          <ul class="space-y-6">
            <li class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center mt-1">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold text-slate-900">Notas SOAP Automáticas</h3>
                <p class="text-slate-500 mt-1">La IA estructura motivo, exploración y diagnóstico en formato estándar sin que usted teclee.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center mt-1">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold text-slate-900">Detección de Riesgos</h3>
                <p class="text-slate-500 mt-1">Análisis en tiempo real que lanza alertas visuales ante parámetros críticos o interacciones medicamentosas.</p>
              </div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Arquitectura "Zero Trust" v2.0</h2>
        <p class="text-slate-500 text-lg">Diseñamos el sistema asumiendo que internet es hostil. Sus datos no solo están guardados, están blindados.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl transition-all">
          <div class="w-14 h-14 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600 mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Row Level Security (RLS)</h3>
          <p class="text-slate-600">Protocolo estricto de Supabase. Ni siquiera nuestros administradores pueden ver los expedientes. Solo su token médico tiene la llave.</p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl transition-all relative overflow-hidden">
          <div class="absolute top-0 right-0 w-20 h-20 bg-teal-500/10 rounded-bl-full"></div>
          <div class="w-14 h-14 bg-teal-100 rounded-lg flex items-center justify-center text-teal-600 mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">NOM-004 Compliant</h3>
          <p class="text-slate-600">Estructura nativa alineada con la normativa mexicana. Genere recetas y expedientes válidos ante COFEPRIS y SSA.</p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl transition-all">
          <div class="w-14 h-14 bg-slate-100 rounded-lg flex items-center justify-center text-slate-600 mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Encriptación Total</h3>
          <p class="text-slate-600">AES-256 en reposo y TLS 1.3 en tránsito. Sus datos viajan en una bóveda digital desde el navegador hasta la nube.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col lg:flex-row-reverse gap-16 items-center mb-24">
        <div class="lg:w-1/2 relative">
             <div class="absolute inset-0 bg-indigo-500 blur-[60px] opacity-10 rounded-full"></div>
             <img src={CHAT_IMG} alt="MediChat Seguro" class="relative rounded-2xl shadow-2xl border border-slate-100" />
        </div>
        <div class="lg:w-1/2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-sm font-bold mb-6">
                NUEVO EN v5.5
            </div>
            <h2 class="text-3xl font-bold text-slate-900 mb-4">MediChat: Comunicación Segura</h2>
            <p class="text-lg text-slate-600 mb-6">
                Olvídese de WhatsApp para temas clínicos. MediChat crea un canal encriptado y restringido dentro de la plataforma.
            </p>
            <ul class="space-y-3 text-slate-600">
                <li class="flex items-center gap-2"><span class="text-green-500">✓</span> <b>Restricción de Dominio:</b> Evita fugas de información.</li>
                <li class="flex items-center gap-2"><span class="text-green-500">✓</span> <b>Historial Vinculado:</b> Chats asociados al expediente.</li>
                <li class="flex items-center gap-2"><span class="text-green-500">✓</span> <b>Entorno Controlado:</b> Sin capturas externas no autorizadas.</li>
            </ul>
        </div>
      </div>

      <div class="bg-slate-900 rounded-3xl p-8 md:p-16 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="relative z-10">
            <h2 class="text-3xl font-bold text-white mb-6">Diseñado para Médicos, no para Informáticos</h2>
            <p class="text-slate-300 text-lg max-w-2xl mx-auto mb-10">
                Interfaz "White & Teal" que reduce la fatiga visual. Accesible desde su PC en el consultorio o su tablet en rondas hospitalarias. Curva de aprendizaje cero.
            </p>
            <div class="flex justify-center gap-8 text-slate-400 text-sm font-mono">
                <div class="flex flex-col items-center">
                    <span class="text-teal-400 text-2xl mb-2 font-bold">3 min</span>
                    Tiempo promedio<br>por nota
                </div>
                <div class="flex flex-col items-center">
                    <span class="text-teal-400 text-2xl mb-2 font-bold">100%</span>
                    Web-Based<br>(No requiere instalar)
                </div>
                <div class="flex flex-col items-center">
                    <span class="text-teal-400 text-2xl mb-2 font-bold">Cloud</span>
                    Sincronización<br>Google Cloud
                </div>
            </div>
        </div>
      </div>

    </div>
  </section>

  <section class="py-24 bg-white border-t border-slate-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900">Preguntas Frecuentes</h2>
      </div>

      <div class="space-y-4">
        <details class="group bg-slate-50 p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Es realmente seguro usar IA con datos de pacientes?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            Sí. VitalScribe utiliza <strong>Google Vertex AI Enterprise</strong>, lo que garantiza que sus datos están encriptados (AES-256) y, lo más importante, <strong>jamás se utilizan para re-entrenar modelos públicos</strong>. Es una bóveda digital privada bajo arquitectura Zero Trust.
          </p>
        </details>

        <details class="group bg-slate-50 p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿La versión 5.5 incluye el módulo de MediChat?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            Sí. Todos los planes (incluyendo la prueba gratuita de 15 días) incluyen acceso completo al MediChat seguro y al motor de generación de notas SOAP con Gemini 2.0.
          </p>
        </details>

        <details class="group bg-slate-50 p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Qué pasa al finalizar la prueba de 15 días?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            Usted mantiene el control total. Puede exportar sus datos en formato PDF/JSON y cerrar su cuenta, o elegir un plan profesional. No realizamos cobros automáticos sin su autorización expresa.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Recupere el Arte de la Medicina</h2>
      <p class="text-lg text-slate-500 mb-10 max-w-2xl mx-auto">
        Prueba VitalScribe v5.5 sin riesgos. 15 días de acceso total a la potencia de Gemini y seguridad bancaria.
      </p>
      
      <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-slate-900 transition-all duration-200 bg-teal-400 rounded-xl hover:bg-teal-300 hover:scale-105 shadow-[0_0_30px_rgba(45,212,191,0.4)] gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        Comenzar Prueba Gratuita
      </a>
      
      <p class="mt-8 text-xs text-slate-400">
        VitalScribe v5.5 • Build 2024.12 • Compliance NOM-004-SSA3-2012
      </p>
    </div>
  </section>

</Layout>

<style>
    @keyframes pulse-slow {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.15; transform: scale(1.1); }
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s infinite ease-in-out;
    }
</style>