      { icon: "🔒", title: "Disponibilidad Hospitalaria", text: "Estructura de servidores redundantes preparada para soportar picos de consulta continua sin degradar el rendimiento del expediente." },
      { icon: "👁️", title: "Solvencia ante Inspecciones", text: "Estructura documental e informes idóneos para solventar con transparencia revisiones regulatorias de la COFEPRIS o autoridades estatales." }
    ]
  },
  {
    id: "roadmap",
    type: "grid",
    title: "V15.4: Arquitectura Temática y Modelado Bio-Bibliográfico",
    clinicalTitle: "Vanguardia en Salud Digital y Precisión Asistencial",
    content: "Hiper-personalización algorítmica y sincronización de agentes RAG para la lectura y síntesis de literatura indexada.",
    clinicalContent: "Capacidades de alta especialización integradas de forma progresiva a su entorno clínico permanente.",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=1000",
    items: [
      { title: "Mapas Fármaco-Genómicos", text: "Integración de mapas fármaco-genómicos complejos para alertas de dosificación automatizadas basadas en el fenotipo celular del paciente." },
      { title: "Espejos Fisiológicos Predictivos", text: "Modelado predictivo de curvas de depuración hepática y renal en tiempo real basado en la telemetría histórica de laboratorios." },
      { title: "Investigación Delegada (RAG)", text: "Sincronización nativa de agentes de conocimiento autónomos para el rastreo y síntesis analítica de literatura médica indexada en PubMed." },
      { title: "Interconexión HL7 Gateway", text: "Acoplamiento asíncrono con gateways hospitalarios institucionales para el intercambio automatizado de expedientes clínicos electrónicos." }
    ],
    clinicalItems: [
      { icon: "🕸️", title: "Auditoría de Polifarmacia", text: "Detección proactiva de efectos adversos y sinergias contraindicadas cuando el paciente se encuentra bajo esquemas multiterapéuticos." },
      { icon: "👥", title: "Simulación de Riesgo Clínico", text: "Visualización predictiva de curvas analíticas ante modificaciones en el tratamiento farmacológico basado en perfiles homólogos." },
      { icon: "🧠", title: "Síntesis Bibliográfica Activa", text: "Análisis automatizado de los últimos artículos científicos indexados relativos a patologías de baja prevalencia durante el juicio clínico." },
      { icon: "🔬", title: "Ajuste Farmacogenético", text: "Alertamiento activo si la dosificación estándar requiere modificaciones según los antecedentes genómicos del paciente." }
    ],
    meta: {
      legalClosing: "VitalScribe AI opera estrictamente como un Sistema de Soporte para la Decisión Clínica (CDSS). Ningún modelo algorítmico sustituye el juicio clínico autónomo del especialista ni genera indicaciones diagnósticas con validez pericial de forma independiente."
    }
  },
  {
    id: "closing",
    type: "hero",
    title: "VitalScribe AI: Inteligencia que Resguarda la Práctica Médica.",
    clinicalTitle: "El Nuevo Estándar en Medicina Especializada Privada",
    subtitle: "v15.3 Global Sentinel Shielded",
    clinicalSubtitle: "Súmese a la Evolución del Acto Clínico",
    content: "Infraestructura inspirada en los más altos estándares hospitalarios globales. Autoverificación de identidad profesional (SEP, CURP), dualidad de firma (e.firma, Rúbrica Digital) y estricto cumplimiento normativo de integridad garantizada.",
    clinicalContent: "Elimine la fatiga documental de su consulta. Permita que VitalScribe asista en la carga documental mientras usted se enfoca firmemente en lo verdaderamente prioritario: el juicio clínico, la relación médico-paciente y la protección de su prestigio profesional.",
    image: "https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=1964",
    meta: { gradient: "from-teal-600 to-blue-900" }
  }
];
---

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<Layout title={title} description={description}>

  <section class="relative overflow-hidden bg-slate-900 min-h-screen flex flex-col justify-center pt-24 pb-20">
    <div class="absolute inset-0 z-0">
      <img 
        src={HERO_IMG} 
        alt="Entorno clínico avanzado y herramientas de apoyo clínico" 
        width="2000" 
        height="1333"
        fetchpriority="high"
        loading="eager"
        class="w-full h-full object-cover opacity-20 filter blur-[12px] scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/95 to-slate-900/70"></div>
    </div>

    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-teal-500/10 rounded-full mix-blend-overlay filter blur-[140px] pointer-events-none will-change-transform"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500/10 rounded-full mix-blend-overlay filter blur-[120px] pointer-events-none will-change-transform"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      
      <div class="flex items-center gap-3 mb-10 select-none">
        <img 
          src="/pwa-512x512.png" 
          alt="Logotipo Oficial VitalScribe AI" 
          width="48"
          height="48"
          class="w-12 h-12 rounded-2xl shadow-[0_4px_20px_rgba(20,184,166,0.15)] border border-slate-800/80 bg-white p-0.5 object-contain [image-rendering:high-quality]"
          onerror="this.onerror=null; this.src='/apple-touch-icon.png';"
        />
        <div class="flex flex-col">
          <span class="text-2xl font-black tracking-tight text-white font-sans leading-none flex items-center">
            VitalScribe<span class="text-teal-400 font-bold ml-0.5">AI</span>
          </span>
          <span class="text-[9px] text-slate-400 tracking-widest font-mono uppercase mt-1">Soporte Clínico Certificado</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center text-left">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-teal-500/40 text-teal-300 text-xs font-bold uppercase tracking-widest backdrop-blur-md shadow-lg">
            <span class="w-2.5 h-2.5 rounded-full bg-teal-400 animate-ping"></span>
            ENTORNO CERTIFICADO PARA PRÁCTICA CLÍNICA ESPECIALIZADA
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight drop-shadow-2xl">
            Implemente el Resguardo Pericial en su <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-400">Consulta Especializada.</span>
          </h1>

          <p class="text-lg md:text-xl text-slate-200 leading-relaxed font-light">
            <strong>Priorice el acto médico y la escucha activa. Nos ocupamos de estructurar y resguardar su evidencia documental.</strong> Acceda a su entorno seguro de evaluación asistencial VitalScribe AI™ v15.3.
          </p>

          <div class="space-y-4 pt-4 border-t border-slate-800/60">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
              <p class="text-slate-300 text-sm">Cédulas de especialidad validadas en tiempo real ante el 
                <span class="group relative inline-block cursor-help border-b border-dotted border-teal-500/50 text-teal-300">Registro Nacional de Profesionistas
                  <span class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-slate-800 text-white text-xs rounded-xl shadow-xl z-50 pointer-events-none">Conexión automatizada en tiempo real para demeritar usurpaciones identitarias profesionales y certificar el alta médica.</span>
                </span>.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
              <p class="text-slate-300 text-sm">Alineación estructural inmediata a los criterios regulatorios obligatorios de la 
                <span class="group relative inline-block cursor-help border-b border-dotted border-teal-500/50 text-teal-300">NOM-004-SSA3-2012
                  <span class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-slate-800 text-white text-xs rounded-xl shadow-xl z-50 pointer-events-none">Criterios científicos y administrativos obligatorios en la integración del expediente clínico electrónico.</span>
                </span>.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center font-bold text-xs shrink-0">✓</span>
              <p class="text-slate-300 text-sm">Aislamiento perimetral criptográfico. Información clínica de pacientes 
                <span class="group relative inline-block cursor-help border-b border-dotted border-teal-500/50 text-teal-300">Soberana y Protegida
                  <span class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-slate-800 text-white text-xs rounded-xl shadow-xl z-50 pointer-events-none">Protected Health Information (PHI): Datos clínicos aislados criptográficamente que nunca son expuestos a modelos de entrenamiento público.</span>
                </span> 
                bajo llaves de cifrado AES-256.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-teal-500/10 rounded-full blur-2xl"></div>
            <h3 class="text-xl font-bold text-white mb-2">Inicialización de Entorno Seguro</h3>
            <p class="text-slate-400 text-xs mb-6">Valide sus datos profesionales para generar sus credenciales criptográficas de acceso local.</p>

            <form id="lead-capture-form" class="space-y-4">
              <div>
                <label for="fullName" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Nombre Completo (conforme a Cédula Profesional)</label>
                <input 
                  type="text" 
                  id="fullName" 
                  name="fullName" 
                  required 
                  placeholder="Dr(a). Nombre Apellido" 
                  class="w-full bg-slate-950/60 border border-slate-800 text-white placeholder-slate-500 rounded-xl px-4 py-3.5 text-sm focus:outline-none focus:border-teal-500/60 focus:ring-1 focus:ring-teal-500/20 transition-all"
                />
              </div>

              <div>
                <label for="cedula" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Cédula Profesional de Especialidad</label>
                <input 
                  type="text" 
                  id="cedula" 
                  name="cedula" 
                  required 
                  inputmode="numeric"
                  pattern="[0-9]{7,8}"
                  placeholder="12345678" 
                  class="w-full bg-slate-950/60 border border-slate-800 text-white placeholder-slate-500 rounded-xl px-4 py-3.5 text-sm font-mono focus:outline-none focus:border-teal-500/60 focus:ring-1 focus:ring-teal-500/20 transition-all"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Línea de Contacto Médico (10 dígitos)</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm font-mono">+52</span>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    required 
                    pattern="[0-9]{10}"
                    placeholder="3331234567" 
                    class="w-full bg-slate-950/60 border border-slate-800 text-white placeholder-slate-500 rounded-xl pl-14 pr-4 py-3.5 text-sm font-mono focus:outline-none focus:border-teal-500/60 focus:ring-1 focus:ring-teal-500/20 transition-all"
                  />
                </div>
              </div>

              <div class="flex justify-center pt-2">
                <div class="cf-turnstile" data-sitekey="0x4AAAAAADksHs-suGPvNkZi" data-theme="dark"></div>
              </div>

              <button type="submit" id="submit-btn" class="w-full py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 text-center font-black text-sm uppercase tracking-wider rounded-xl transition-all shadow-md transform active:scale-95 mt-4 flex items-center justify-center gap-2">
                Activar Periodo de Evaluación Asistencial
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Soberanía Diagnóstica y Flujo Asistencial Optimizado</h2>
        <p class="text-slate-600 mt-4 text-lg max-w-2xl mx-auto">
          Análisis comparativo del impacto de la Inteligencia Ambiental en la mitigación del desgaste profesional y el fortalecimiento de la evidencia documental médica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-slate-100 overflow-hidden transform hover:-translate-y-2 transition-all duration-300">
          <div class="p-6 bg-teal-900 flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-teal-800 flex items-center justify-center text-2xl">🗣️</span>
            <div>
              <h4 class="font-bold text-lg leading-tight text-white animate-fade-in-up">Anamnesis Compleja y Gestión Documental</h4>
              <span class="text-teal-300 text-xs font-mono font-bold tracking-wider">PROTECCIÓN DEL TIEMPO CLÍNICO</span>
            </div>
          </div>
          <div class="p-8 space-y-6">
            <div class="opacity-75 relative pl-4 border-l-2 border-slate-300">
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Registro Convencional</span>
              <p class="text-sm text-slate-600 font-medium">La captura manual de la nota de evolución demerita el tiempo dedicado a la exploración, forzando la transcripción mecánica y la búsqueda diferida de códigos CIE-11.</p>
            </div>
            <div class="relative pl-4 border-l-2 border-teal-500 bg-teal-50/70 p-4 rounded-r-xl">
              <span class="text-[10px] font-black text-teal-700 uppercase tracking-widest block mb-1">Entorno VitalScribe</span>
              <p class="text-sm text-slate-900 font-bold leading-relaxed">Priorice la interacción clínica. La Inteligencia Ambiental procesa el diálogo médico, aísla ruidos de fondo, estructura el formato SOAP y sugiere la codificación diagnóstica en tiempo real.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-slate-100 overflow-hidden transform hover:-translate-y-2 transition-all duration-300">
          <div class="p-6 bg-indigo-900 flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-indigo-800 flex items-center justify-center text-2xl">⚠️</span>
            <div>
              <h4 class="font-bold text-lg leading-tight text-white animate-fade-in-up">Farmacovigilancia y Seguridad del Paciente</h4>
              <span class="text-indigo-300 text-xs font-mono font-bold tracking-wider">MITIGACIÓN DE RIESGOS</span>
            </div>
          </div>
          <div class="p-8 space-y-6">
            <div class="opacity-75 relative pl-4 border-l-2 border-slate-300">
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Registro Convencional</span>
              <p class="text-sm text-slate-600 font-medium">Bajo fatiga asistencial por jornadas prolongadas, el riesgo relativo de obviar interacciones farmacológicas o alergias cruzadas ocultas en el historial clínico aumenta sustancialmente.</p>
            </div>
            <div class="relative pl-4 border-l-2 border-indigo-500 bg-indigo-50/70 p-4 rounded-r-xl">
              <span class="text-[10px] font-black text-indigo-700 uppercase tracking-widest block mb-1">Entorno VitalScribe</span>
              <p class="text-sm text-slate-900 font-bold leading-relaxed">El firewall Omni-Sentinel evalúa los parámetros analíticos (como la TFG) y emite un alertamiento visual de seguridad clínica previo a la validación de la receta.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.08)] border border-slate-100 overflow-hidden transform hover:-translate-y-2 transition-all duration-300">
          <div class="p-6 bg-slate-900 flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-2xl">⚖️</span>
            <div>
              <h4 class="font-bold text-lg leading-tight text-white animate-fade-in-up">Sustento Pericial ante Controversias Médicas</h4>
              <span class="text-slate-300 text-xs font-mono font-bold tracking-wider">RESGUARDO PERICIAL</span>
            </div>
          </div>
          <div class="p-8 space-y-6">
            <div class="opacity-75 relative pl-4 border-l-2 border-slate-300">
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Registro Convencional</span>
              <p class="text-sm text-slate-600 font-medium">Ante un requerimiento de comisiones dictaminadoras, las notas clínicas incompletas u la redacción inadecuada comprometen la solidez del sustento de la defensa pericial.</p>
            </div>
            <div class="relative pl-4 border-l-2 border-slate-700 bg-slate-100 p-4 rounded-r-xl">
              <span class="text-[10px] font-black text-slate-800 uppercase tracking-widest block mb-1">Entorno VitalScribe</span>
              <p class="text-sm text-slate-900 font-bold leading-relaxed">La herramienta sugiere una redacción científica probabilística, incorpora citas de Guías de Práctica Clínica y asocia firma electrónica de forma inmutable. Caso cerrado.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="presentation-hub" class="py-24 bg-slate-950 relative border-t border-slate-900 overflow-hidden presentation-mode-clinical">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(20,184,166,0.07),transparent_70%)]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-8">
        <span class="px-3 py-1 text-xs font-semibold tracking-wider text-teal-300 uppercase bg-teal-950/80 border border-teal-500/30 rounded-full">
          CONSOLA DE ARQUITECTURA E INTEGRIDAD v15.3
        </span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mt-4 tracking-tight">
          Navegue por el Entorno Clínico Estructurado
        </h2>
        <p class="text-slate-400 text-lg max-w-3xl mx-auto mt-4">
          Explore los mecanismos criptográficos y asistenciales que garantizan la continuidad asistencial y el resguardo institucional de su práctica médica.
        </p>
      </div>

      <div class="flex justify-center mb-12">
        <div class="bg-slate-900 p-1.5 rounded-full border border-slate-700 flex shadow-lg items-center relative">
          <button id="mode-clinical-btn" class="relative z-10 px-6 py-2.5 rounded-full bg-teal-50 text-slate-950 font-bold text-sm transition-colors duration-300 flex items-center gap-2">
            👨‍⚕️ Criterio Clínico y Asistencial
          </button>
          <button id="mode-technical-btn" class="relative z-10 px-6 py-2.5 rounded-full text-slate-400 hover:text-white font-medium text-sm transition-colors duration-300 flex items-center gap-2">
            ⚙️ Infraestructura y Cumplimiento Técnico
          </button>
        </div>
      </div>

      <div class="bg-slate-900 rounded-3xl border border-slate-800 shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[580px]">
        
        <div class="lg:col-span-4 border-r border-slate-800 bg-slate-900/50 flex flex-col justify-between max-h-[600px] overflow-y-auto custom-scrollbar">
          <div class="p-4 border-b border-slate-800 bg-slate-950/30">
            <span class="text-xs font-mono text-slate-500">ÍNDICE DE PLATAFORMA</span>
          </div>
          <div class="p-2 space-y-1 flex-1">
            {slides.map((slide, index) => (
              <button 
                class={`slide-tab w-full text-left p-3.5 rounded-xl transition-all flex items-center gap-3 border-b ${index === 0 ? 'bg-teal-950/40 text-teal-300 border-teal-500/30' : 'text-slate-400 border-transparent hover:bg-slate-800/50 hover:text-white'}`}
                data-slide-id={slide.id}
                data-index={index}
              >
                <span class="font-mono text-xs text-teal-400/70 bg-slate-950/60 w-6 h-6 rounded-md flex items-center justify-center font-bold shrink-0">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="truncate font-sans">
                  <p class="font-bold text-sm leading-none truncate block technical-text text-white">{slide.title}</p>
                  <p class="text-[10px] text-slate-500 font-mono mt-1 capitalize technical-text">Especificación de TI</p>
                  <p class="font-bold text-sm leading-none truncate hidden clinical-text text-white">{slide.clinicalTitle || slide.title}</p>
                  <p class="text-[10px] text-teal-500/80 font-mono mt-1 uppercase hidden clinical-text">Criterio Asistencial</p>
                </div>
              </button>
            ))}
          </div>
        </div>

        <div class="lg:col-span-8 p-8 md:p-12 flex flex-col justify-between bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 relative min-h-[450px]">
          <div class="absolute top-4 right-4 w-40 h-40 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div class="flex-1 flex flex-col justify-start relative w-full h-full font-sans">
            {slides.map((slide, index) => (
              <div 
                id={`viewer-${slide.id}`} 
                class={`slide-pane w-full flex-col justify-between transition-opacity duration-300 ${index === 0 ? 'relative flex opacity-100 animate-pulse-slow' : 'hidden opacity-0 absolute pointer-events-none h-0'}`}
                data-index={index}
              >
                <div class="w-full overflow-y-auto max-h-[360px] lg:max-h-[420px] custom-scrollbar pr-2 space-y-6 scroll-smooth">
                  
                  {slide.type === 'hero' && (
