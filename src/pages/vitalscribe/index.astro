<script is:inline>
  // Encapsulado global para prevenir y capturar fallos sin romper la carga de la página
  (function() {
    // Escucha defensiva de errores para suprimir el problemático "[GLOBAL] Script error."
    window.addEventListener('error', function(event) {
      if (event && (event.message === 'Script error.' || !event.filename)) {
        event.preventDefault();
        return true;
      }
    }, true);

    try {
      document.addEventListener('DOMContentLoaded', () => {
        // ----------------------------------------------------
        // CONTROL DEL FORMULARIO DE CONVERSIÓN DE 3 CAMPOS
        // ----------------------------------------------------
        const form = document.getElementById('lead-capture-form');
        const submitBtn = document.getElementById('submit-btn');

        if (form) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Deshabilitar botón
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Generando Credenciales...";
            }

            // Obtener inputs de forma segura
            const fullNameEl = document.getElementById('fullName');
            const specialtyEl = document.getElementById('specialty');
            const phoneEl = document.getElementById('phone');

            const fullName = fullNameEl ? fullNameEl.value.trim() : '';
            const specialty = specialtyEl ? specialtyEl.value : '';
            const phone = phoneEl ? phoneEl.value.trim() : '';

            try {
              // Retardo de credibilidad de 1.5s
              await new Promise(resolve => setTimeout(resolve, 1500)); 
              
              // Guardar temporalmente en localStorage con envoltura de seguridad
              try {
                localStorage.setItem('vitalscribe_lead', JSON.stringify({ fullName, specialty, phone }));
              } catch (storageError) {
                // Silenciar errores de localStorage si se ejecuta en iFrame sin permisos de almacenamiento
                console.warn("Storage access restricted in this sandbox environment:", storageError);
              }

              // Redirección con parámetros limpios
              const redirectUrl = `https://vitalscribeai.com/?ref=VIP_COHORTE_1&name=${encodeURIComponent(fullName)}&spec=${encodeURIComponent(specialty)}`;
              window.location.href = redirectUrl;

            } catch (innerError) {
              console.error("Error en el registro local del lead:", innerError);
              window.location.href = "https://vitalscribeai.com/";
            }
          });
        }

        // ----------------------------------------------------
        // NAVEGACIÓN INTERACTIVA DE DIAPOSITIVAS (VIEWER v11.0)
        // ----------------------------------------------------
        const tabs = document.querySelectorAll('.slide-tab');
        const panes = document.querySelectorAll('.slide-pane');
        const prevBtn = document.getElementById('prev-slide-btn');
        const nextBtn = document.getElementById('next-slide-btn');
        const counterBadge = document.getElementById('slide-counter-badge');
        
        let activeIndex = 0;
        const totalSlides = tabs.length;

        function updateViewer(index) {
          if (index < 0 || index >= totalSlides) return;
          
          activeIndex = index;

          tabs.forEach((tab, idx) => {
            if (idx === index) {
              tab.classList.add('bg-teal-950/40', 'text-teal-300', 'border-teal-500/30');
              tab.classList.remove('text-slate-400', 'border-transparent');
              
              // scrollIntoView adaptado de forma segura para navegadores antiguos
              if (tab && typeof tab.scrollIntoView === 'function') {
                try {
                  tab.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } catch (scrollErr) {
                  // Fallback para navegadores antiguos sin parámetros de comportamiento
                  try {
                    tab.scrollIntoView();
                  } catch (e) {}
                }
              }
            } else {
              tab.classList.remove('bg-teal-950/40', 'text-teal-300', 'border-teal-500/30');
              tab.classList.add('text-slate-400', 'border-transparent');
            }
          });

          panes.forEach((pane, idx) => {
            if (idx === index) {
              pane.classList.remove('hidden', 'opacity-0');
              pane.classList.add('flex');
              setTimeout(() => {
                pane.style.opacity = '1';
              }, 50);
            } else {
              pane.classList.add('hidden', 'opacity-0');
              pane.classList.remove('flex');
              pane.style.opacity = '0';
            }
          });

          if (counterBadge) {
            counterBadge.textContent = `SLIDE ${index + 1} DE ${totalSlides}`;
          }
          
          if (prevBtn) {
            if (index === 0) {
              prevBtn.style.opacity = '0.5';
              prevBtn.style.pointerEvents = 'none';
            } else {
              prevBtn.style.opacity = '1';
              prevBtn.style.pointerEvents = 'auto';
            }
          }

          if (nextBtn) {
            if (index === totalSlides - 1) {
              nextBtn.textContent = 'REINICIAR ↺';
            } else {
              nextBtn.textContent = 'SIGUIENTE →';
            }
          }
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            updateViewer(index);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (activeIndex > 0) {
              updateViewer(activeIndex - 1);
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (activeIndex < totalSlides - 1) {
              updateViewer(activeIndex + 1);
            } else {
              updateViewer(0);
            }
          });
        }

        // Gestos táctiles Swipe con coordenadas a prueba de fallos
        const viewerContainer = document.getElementById('presentation-hub');
        let touchStartX = 0;
        let touchEndX = 0;

        if (viewerContainer) {
          viewerContainer.addEventListener('touchstart', (e) => {
            if (e.changedTouches && e.changedTouches.length > 0) {
              touchStartX = e.changedTouches[0].screenX;
            }
          }, { passive: true });

          viewerContainer.addEventListener('touchend', (e) => {
            if (e.changedTouches && e.changedTouches.length > 0) {
              touchEndX = e.changedTouches[0].screenX;
              handleSwipe();
            }
          }, { passive: true });
        }

        function handleSwipe() {
          const swipeThreshold = 50;
          if (touchStartX - touchEndX > swipeThreshold) {
            if (activeIndex < totalSlides - 1) {
              updateViewer(activeIndex + 1);
            }
          } else if (touchEndX - touchStartX > swipeThreshold) {
            if (activeIndex > 0) {
              updateViewer(activeIndex - 1);
            }
          }
        }

        // Inicialización inicial
        updateViewer(0);
      });
    } catch (globalException) {
      // Capturar y silenciar para evitar el burbujeo de excepciones en el contenedor
      console.error("VitalScribe SafeScript caught a global exception:", globalException);
    }
  })();
</script>