// PROTOCOLO VITALSCRIBE v5.4: INTEGRACIÓN COMPLETA DE PRESENTACIÓN v11.0 CON AJUSTES REGULATORIOS Y MATRIZ DE PRECIOS
// ESTADO: PRODUCCIÓN (Estricto, Saneado, Monolítico, Libre de Alertas de COFEPRIS/DGIS)

import Layout from '../../layouts/Layout.astro';

// ==========================================
// CONFIGURACIÓN Y METADATOS (Elevados a v11.0 con Alineación Normativa)
// ==========================================
const title = "Acceso VIP | VitalScribe AI v11.0 - Prueba de 15 Días";
const description = "Reclame su Prueba Premium de 15 días en la Bóveda de Grado Forense VitalScribe AI™ v11.0. Cupos Limitados para la Primera Cohorte en México.";
const APP_URL = "https://vitalscribeai.com/";

// ==========================================
// IMÁGENES DE ALTA ENTRÓPÍA Y PRECISIÓN
// ==========================================
const HERO_IMG = "https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&q=80&w=2000";
const SPEED_IMG = "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1000";
const SECURITY_IMG = "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&q=80&w=2000";

// ==========================================
// DATA DE PRESENTACIÓN CORPORATIVA (Mapeada para Render Dinámico)
// ==========================================
const slides = [
  {
    id: "intro",
    type: "hero",
    title: "VitalScribe AI v11.0", 
    subtitle: "Clinical Decision Support System (CDSS) & Identity Shield",
    content: "Arquitectura Omni-Sentinel: El único ecosistema de Blindaje Forense y Seguridad Activa con Verificación Federal en Vivo ante la SEP, CURP e Infraestructura de Firma Avanzada y Autógrafa.",
    image: "https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&q=80&w=2000", 
    meta: { gradient: "from-teal-600 to-slate-900" }
  },
  {
    id: "moat",
    type: "split",
    title: "Cerebro Clínico vs. Agenda Digital",
