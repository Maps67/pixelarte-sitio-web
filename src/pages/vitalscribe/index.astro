---
// Archivo: src/pages/vitalscribe/index.astro
// PROTOCOLO VITALSCRIBE v5.4: INTEGRIDAD VISUAL + ACTUALIZACIÓN A GEMINI 3.0 FLASH
// ESTADO: PRODUCCIÓN

import Layout from '../../layouts/Layout.astro';

// ==========================================
// CONFIGURACIÓN Y METADATOS
// ==========================================
const title = "VitalScribe | Medicina de Precisión con Vertex AI y Gemini 3.0";
const description = "Plataforma clínica impulsada por Google Gemini 3.0 Flash. Notas instantáneas, detección de riesgos y seguridad Enterprise Vertex AI.";
const APP_URL = "https://vitalscribeai.com/";

// ==========================================
// IMÁGENES (Optimizadas)
// ==========================================
const HERO_IMG = "https://images.unsplash.com/photo-1551076882-68b47d190267?auto=format&fit=crop&q=80&w=2000";
const SPEED_IMG = "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1000";
const SECURITY_IMG = "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&q=80&w=1000";
---

<Layout title={title}>

  <section class="relative overflow-hidden bg-slate-900 min-h-screen flex items-center pt-20 pb-20">
    
    <div class="absolute inset-0 z-0">
      <img 
        src={HERO_IMG} 
        alt="Tecnología médica avanzada" 
        width="2000" 
        height="1333"
        fetchpriority="high"
        loading="eager"
        class="w-full h-full object-cover opacity-40 filter blur-[8px] scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/50"></div>
    </div>

    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-teal-500 rounded-full mix-blend-overlay filter blur-[120px] opacity-20 animate-pulse-slow pointer-events-none will-change-transform"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-20 pointer-events-none will-change-transform"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/60 border border-teal-500/30 text-teal-300 text-xs font-bold uppercase tracking-widest mb-8 backdrop-blur-md shadow-lg">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
        Powered by Vertex AI • Gemini 3.0 Flash
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight text-white mb-6 leading-tight drop-shadow-2xl">
        Medicina de Precisión a la <br class="hidden md:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-400">Velocidad de la Luz.</span>
      </h1>

      <p class="text-lg md:text-2xl text-slate-200 max-w-4xl mx-auto mb-10 leading-relaxed font-light drop-shadow-md">
        La primera plataforma de gestión clínica en México impulsada por el nuevo motor <strong>Google Gemini 3.0 Flash</strong>. Notas instantáneas, detección de riesgos y seguridad Enterprise.
      </p>

      <div class="flex flex-col sm:flex-row gap-5 justify-center items-center">
        <a 
          href={APP_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group w-full sm:w-auto px-10 py-5 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-lg rounded-xl transition-all shadow-[0_0_30px_rgba(20,184,166,0.4)] flex items-center justify-center gap-3 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(20,184,166,0.6)]"
        >
          Iniciar Prueba Blindada
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
        </a>
        
        <a 
          href="#features" 
          class="w-full sm:w-auto px-10 py-5 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium text-lg rounded-xl transition-all backdrop-blur-sm flex items-center justify-center gap-3"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Ver la IA en Acción
        </a>
      </div>
    </div>
  </section>

  <section id="features" class="py-24 bg-white relative z-20 -mt-10 rounded-t-[3rem] shadow-[0_-20px_60px_rgba(0,0,0,0.2)] scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid md:grid-cols-3 gap-12">
        
        <div class="group p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-2xl hover:border-teal-200 transition-all duration-300">
          <div class="w-16 h-16 bg-teal-100 text-teal-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-teal-600 transition-colors">Velocidad "Flash"</h3>
          <p class="text-slate-600 leading-relaxed">
            Potenciado por <strong>Gemini 3.0</strong>. Tus notas y resúmenes clínicos no "cargan", aparecen instantáneamente. Cero latencia en consulta.
          </p>
        </div>

        <div class="group p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-2xl hover:border-indigo-200 transition-all duration-300">
          <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-indigo-600 transition-colors">Privacidad Enterprise</h3>
          <p class="text-slate-600 leading-relaxed">
            Corremos sobre la nube privada <strong>Google Vertex AI</strong>. Tus datos clínicos NUNCA se usan para entrenar a la IA pública. Aislamiento total.
          </p>
        </div>

        <div class="group p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-2xl hover:border-pink-200 transition-all duration-300">
          <div class="w-16 h-16 bg-pink-100 text-pink-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-pink-600 transition-colors">Tu Clínica en el Bolsillo</h3>
          <p class="text-slate-600 leading-relaxed">
            Diseño 100% responsivo. Empieza la nota en tu Laptop y termínala en tu iPad o celular mientras caminas a la siguiente sala.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-32">
      
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2">
          <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider text-teal-600 uppercase bg-teal-100 rounded-full">
            🧠 El Cerebro
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Asistente Clínico Inteligente</h2>
          <p class="text-lg text-slate-600 mb-8 font-medium">Tu copiloto que nunca duerme.</p>
          
          <ul class="space-y-8">
            <li class="flex items-start">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-500 flex items-center justify-center text-white font-bold mt-1 shadow-md shadow-teal-200">1</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Redacción Estructurada</h4>
                <p class="text-slate-500 mt-1">Convierte dictados rápidos o ideas sueltas en notas SOAP con formato médico perfecto.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-red-500 flex items-center justify-center text-white font-bold mt-1 shadow-md shadow-red-200">2</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Monitor de Riesgos en Vivo</h4>
                <p class="text-slate-500 mt-1">Detecta combinaciones peligrosas (ej. Alergias cruzadas) y lanza una <span class="text-red-600 font-bold bg-red-50 px-1 rounded">Alerta Visual</span>.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-500 flex items-center justify-center text-white font-bold mt-1 shadow-md shadow-teal-200">3</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Resumen "Flash"</h4>
                <p class="text-slate-500 mt-1">Antes de que el paciente se siente, la IA lee el historial y te da un resumen de 3 líneas con lo vital.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="lg:w-1/2 relative">
          <div class="absolute inset-0 bg-gradient-to-tr from-teal-400 to-indigo-500 blur-3xl opacity-20 rounded-full"></div>
          <img 
            src={SPEED_IMG} 
            alt="IA procesando datos" 
            width="1000" height="600"
            loading="lazy"
            decoding="async"
            class="relative rounded-2xl shadow-2xl border-4 border-white transform hover:scale-[1.02] transition-transform duration-500 object-cover h-[500px] w-full" 
          />
        </div>
      </div>

      <div class="flex flex-col lg:flex-row-reverse gap-16 items-center">
        <div class="lg:w-1/2">
          <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider text-indigo-600 uppercase bg-indigo-100 rounded-full">
            🛡️ Blindaje v2.0
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Seguridad de Grado Bancario</h2>
          <p class="text-lg text-slate-600 mb-8 font-medium">Protegemos tu cédula y a tus pacientes bajo normativa NOM-004.</p>
          
          <ul class="space-y-8">
            <li class="flex items-start">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold mt-1 shadow-md shadow-indigo-200">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Arquitectura "Zero Trust"</h4>
                <p class="text-slate-500 mt-1">Seguridad a nivel de fila (RLS). Solo tu llave digital única puede descifrar tus expedientes.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold mt-1 shadow-md shadow-indigo-200">✓</div>
              <div class="ml-4">
                <h4 class="text-lg font-bold text-slate-900">Encriptación Militar</h4>
                <p class="text-slate-500 mt-1">Tus datos viajan cifrados (TLS) y descansan cifrados (AES-256) en bóvedas digitales.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="lg:w-1/2 relative">
          <div class="absolute inset-0 bg-gradient-to-tl from-indigo-400 to-pink-500 blur-3xl opacity-20 rounded-full"></div>
          <img 
            src={SECURITY_IMG} 
            alt="Bóveda digital de seguridad" 
            width="1000" height="600"
            loading="lazy"
            decoding="async"
            class="relative rounded-2xl shadow-2xl border-4 border-white transform hover:scale-[1.02] transition-transform duration-500 object-cover h-[500px] w-full" 
          />
        </div>
      </div>

    </div>
  </section>

  <section class="py-24 bg-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ficha Técnica de Infraestructura</h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Especificaciones para departamentos de TI y auditorías de seguridad.
        </p>
      </div>

      <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-3 text-left">
          
          <div class="hidden md:contents bg-slate-900 text-slate-400 font-mono text-xs uppercase tracking-wider">
            <div class="p-6 border-b border-slate-700">Componente</div>
            <div class="p-6 border-b border-slate-700">Tecnología</div>
            <div class="p-6 border-b border-slate-700">Beneficio Clínico/Técnico</div>
          </div>

          <div class="p-6 border-b border-slate-700 md:bg-slate-800/50 text-teal-400 font-bold">Cloud IA</div>
          <div class="p-6 border-b border-slate-700 text-white font-mono">Google Cloud Vertex AI</div>
          <div class="p-6 border-b border-slate-700 text-slate-300 text-sm">Privacidad de Datos garantizada por contrato Enterprise.</div>

          <div class="p-6 border-b border-slate-700 md:bg-slate-800/50 text-teal-400 font-bold">Modelo LLM</div>
          <div class="p-6 border-b border-slate-700 text-white font-mono">Gemini 3.0 Flash</div>
          <div class="p-6 border-b border-slate-700 text-slate-300 text-sm">Latencia ultra-baja y razonamiento médico avanzado de nueva generación.</div>

          <div class="p-6 border-b border-slate-700 md:bg-slate-800/50 text-teal-400 font-bold">Base de Datos</div>
          <div class="p-6 border-b border-slate-700 text-white font-mono">Supabase (PostgreSQL)</div>
          <div class="p-6 border-b border-slate-700 text-slate-300 text-sm">Integridad relacional y políticas de seguridad RLS.</div>

          <div class="p-6 md:bg-slate-800/50 text-teal-400 font-bold">Frontend</div>
          <div class="p-6 text-white font-mono">React + Astro</div>
          <div class="p-6 text-slate-300 text-sm">Experiencia de usuario fluida (SPA) sin recargas.</div>

        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900">Preguntas Frecuentes</h2>
        <p class="text-slate-500 mt-2">Tecnología explicada de forma sencilla.</p>
      </div>

      <div class="space-y-4">
        
        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Google lee los datos de mis pacientes?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            <strong>No.</strong> VitalScribe opera bajo un contrato de privacidad Enterprise. Google actúa solo como procesador ciego; tus datos no se almacenan en sus servidores públicos ni entrenan a sus modelos.
          </p>
        </details>

        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Qué tan rápido es?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            <strong>Gemini 3.0 Flash</strong> es extremadamente veloz. Generar una nota clínica completa toma menos tiempo del que tardas en tomar un sorbo de café.
          </p>
        </details>

        <details class="group bg-white p-6 rounded-xl border border-slate-200 cursor-pointer open:ring-2 open:ring-teal-500/20 transition-all shadow-sm">
          <summary class="flex justify-between items-center font-bold text-slate-800 list-none">
            ¿Necesito un equipo potente?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            No. Todo el procesamiento pesado ocurre en nuestra nube. Funciona perfecto en cualquier laptop básica, tablet o celular con navegador actualizado.
          </p>
        </details>

      </div>
    </div>
  </section>

  <footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row justify-between items-start mb-12">
        <div class="mb-8 md:mb-0 max-w-sm">
          <h2 class="text-2xl font-bold text-white tracking-tighter">VitalScribe<span class="text-teal-400">AI</span></h2>
          <p class="text-slate-400 text-sm mt-4 leading-relaxed">
            La evolución de la práctica médica. Potenciando a los doctores de México con inteligencia artificial segura y eficiente.
          </p>
        </div>
        
        <div class="flex flex-col gap-4 text-right">
            <span class="text-slate-500 text-xs font-mono uppercase tracking-widest">Tecnología</span>
            <span class="text-slate-300 text-sm">Powered by Google Vertex AI</span>
            <span class="text-slate-300 text-sm">Gemini 3.0 Flash Engine</span>
            <span class="text-slate-300 text-sm">Supabase Secure Cloud</span>
        </div>
      </div>

      <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-slate-500 text-xs">
          © 2025 VitalScribe. Todos los derechos reservados.
        </p>
        <div class="flex gap-6 text-slate-500 text-xs font-medium">
          <a href="#" class="hover:text-teal-400 transition-colors">Cumplimiento NOM-004</a>
          <a href="#" class="hover:text-teal-400 transition-colors">Aviso de Privacidad</a>
        </div>
      </div>

    </div>
  </footer>

</Layout>

<style>
    /* Habilita el scroll suave para los enlaces ancla */
    html {
        scroll-behavior: smooth;
    }

    @keyframes pulse-slow {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.15; transform: scale(1.1); }
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s infinite ease-in-out;
    }
</style>