    type: "grid",
    title: "Anestesiología: La 'Caja Negra'",
    content: "Cumplimiento milimétrico de la NOM-006-SSA3-2011.",
    items: [
      { icon: "📊", title: "Triple Registro", text: "Segmentación forense: Valoración Pre, Registro Trans y Recuperación UCPA." },
      { icon: "🔒", title: "Asistencia en Recuperación", text: "Soporte en Aldrete Score: Asistencia visual para la evaluación de criterios de alta a piso post-quirúrgico." },
      { icon: "⚡", title: "Cronometría Médica", text: "Trazabilidad exacta de inducción, incisión y eventos transoperatorios críticos." },
      { icon: "🛡️", title: "Defensa Activa", text: "Documentación inexpugnable ante eventos adversos para blindar la responsabilidad." }
    ]
