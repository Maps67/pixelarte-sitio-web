---
// src/layouts/Layout.astro (VERSIÓN CORREGIDA CON COMPONENTE)
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToastNotification from '../components/ToastNotification.astro'; // <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    
    <link rel="canonical" href={currentUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Pixelarte Studio" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={finalSocialImageUrl} />
    <meta property="og:image:alt" content={finalSocialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalSocialImageUrl} />
    <meta name="twitter:image:alt" content={finalSocialImageAlt} />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

    <ToastNotification /> </body>
</html>