---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    canonicalUrl?: string;
    ogImage?: string; 
    ogImageAlt?: string;
}

const { 
    title, 
    description, 
    canonicalUrl, 
    ogImage, 
    ogImageAlt 
} = Astro.props;

const siteUrl = Astro.site || new URL('https://pixelartestudio.art'); 
const pageTitle = `${title} | Pixelarte Studio`;
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;

const fallbackImageUrl = new URL('/images/social-cover-default.png', siteUrl).href;
const fallbackImageAlt = 'Pixelarte Studio - Soluciones Creativas y Estrategia Visual';

const finalSocialImageUrl = ogImage ? new URL(ogImage, siteUrl).href : fallbackImageUrl;
const finalSocialImageAlt = ogImageAlt || fallbackImageAlt;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Pixelarte Studio",
  "url": typeof siteUrl === 'string' ? siteUrl : siteUrl.href,
  "logo": new URL('/favicon.svg', siteUrl).href,
  "image": finalSocialImageUrl,
  "description": description,
  "telephone": "+523347211199",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "MX"
  },
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61578631474398",
    "https://www.instagram.com/pixel.arte.studio"
  ]
};
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Optimización Crítica de Tipografía: Conexión Anticipada y Render Inmediato -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Playfair+Display:wght@700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Playfair+Display:wght@700&display=swap" />
    
    <link rel="canonical" href={currentUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Pixelarte Studio" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={finalSocialImageUrl} />
    <meta property="og:image:alt" content={finalSocialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalSocialImageUrl} />
    <meta name="twitter:image:alt" content={finalSocialImageAlt} />

    <!-- Schema.org Datos Estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>