---
// src/components/ToastNotification.astro (VERSIÓN LIMPIA)
// Se ha eliminado "import { clientLoad }"
---

<div id="toast-notification" class="fixed bottom-6 right-6 z-50 max-w-sm p-4 bg-white rounded-lg shadow-2xl transition-all duration-500 ease-out opacity-0 translate-y-2 transform">
  <div class="flex items-start justify-between">
    <div class="flex-grow">
      <p class="font-bold text-oscuro">Nuevo en el Blog</p>
      <a href="/blog/matematica-burnout/" class="text-sm text-acento hover:underline">
        La Matemática del Burnout: El Costo Oculto del Teclado
      </a>
    </div>
    <button id="toast-close-btn" class="ml-3 p-1 text-secundario hover:text-oscuro" aria-label="Cerrar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
</div>

<script is:inline>
  // Usamos el setTimeout de 100ms para evitar la "carrera"
  setTimeout(() => {
    const TOAST_ID = 'toast_matematica_burnout'; 
    const toastElement = document.getElementById('toast-notification');
    const closeButton = document.getElementById('toast-close-btn');

    if (!toastElement || !closeButton) {
      console.error('Error: Elementos del Toast no encontrados en el DOM.');
      return; 
    }

    const isDismissed = localStorage.getItem(TOAST_ID);

    if (!isDismissed) {
      // Espera de 1.5s antes de mostrar
      setTimeout(() => {
        toastElement.classList.remove('opacity-0', 'translate-y-2');
        toastElement.classList.add('opacity-100', 'translate-y-0');
      }, 1500);
    }

    closeButton.addEventListener('click', () => {
      toastElement.classList.remove('opacity-100', 'translate-y-0');
      toastElement.classList.add('opacity-0', 'translate-y-2');
      localStorage.setItem(TOAST_ID, 'true');
      
      setTimeout(() => {
        toastElement.style.display = 'none';
      }, 500); 
    });
  }, 100); // 100ms de retraso
</script>