/*
  # 1. PROTECCIÓN CONTRA SNIFFING DE CONTENIDO
  X-Content-Type-Options: nosniff

  # 2. PROTECCIÓN CONTRA CLICKJACKING
  X-Frame-Options: SAMEORIGIN

  # 3. FILTRO XSS PARA NAVEGADORES COMPATIBLES
  X-XSS-Protection: 1; mode=block

  # 4. POLÍTICA DE REFERENCIA SEGURA
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. RESTRICCIÓN DE PERMISOS DE HARDWARE NO UTILIZADOS
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # 6. FORZADO DE HTTPS (HSTS - 1 AÑO + SUBDOMINIOS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload